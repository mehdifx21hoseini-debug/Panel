<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch: Electric Blue splash, then the Compose theme takes over. -->
    <style name="Theme.FitOS.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fitos_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FitOS</item>
    </style>

    <style name="Theme.FitOS" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fitos_background</item>
    </style>
</resources>
